#!name=TestFlight Relay
#!desc=TestFlight 脚本中继（Stash 适配版）

[Script]
TF-Relay = type=http-request, pattern=^http://tf-relay\.test(?::8799)?/, requires-body=true, max-size=1048576, script-path=https://cdn.jsdelivr.net/gh/your98k/tf-relay-compat@main/tfrelay.compat.js
TF-Relay-Refresh = type=cron, cronexp="0 */5 * * *", script-path=https://cdn.jsdelivr.net/gh/your98k/tf-relay-compat@main/tfrelay.compat.js
