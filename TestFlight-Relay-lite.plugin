#!name=TestFlight Relay
#!desc=TestFlight 脚本中继（Loon 适配版）
#!author=your98k
#!system=ios

[Script]
http-request ^http://tf-relay\.test(?::8799)?/ script-path=https://cdn.jsdelivr.net/gh/your98k/tf-relay-compat@main/tfrelay.compat.js, requires-body=true, max-size=1048576, tag=TF-Relay
cron "0 */5 * * *" script-path=https://cdn.jsdelivr.net/gh/your98k/tf-relay-compat@main/tfrelay.compat.js, tag=TF-Relay-Refresh

[MITM]
hostname = %APPEND% tf-relay.test
