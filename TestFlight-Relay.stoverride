name: 'TestFlight Relay'
desc: 'TestFlight 脚本中继：请求中转、多账号索引合并、详情缓存（Stash 适配版）'

script-providers:
  tf-relay:
    url: https://cdn.jsdelivr.net/gh/your98k/tf-relay-compat@main/tfrelay.compat.js
    interval: 86400

http:
  # 明文 HTTP 且非标准端口，必须强制走 HTTP 引擎，否则脚本不会被触发
  force-http-engine:
    - 'tf-relay.test:8799'
    - 'tf-relay.test:80'
  script:
    - name: tf-relay
      match: '^http://tf-relay\.test(?::8799)?/'
      type: request
      require-body: true
      max-size: 1048576
      timeout: 60
      engine: jsc

cron:
  script:
    - name: tf-relay
      cron: '0 */5 * * *'
      timeout: 60
